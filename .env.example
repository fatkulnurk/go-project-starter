# ===== App =====
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ===== Database (mysql default, postgres optional) =====
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=go_project_starter

# For postgres use: DB_DRIVER=postgres, DB_PORT=5432

# ===== Cache (redis default, memory optional) =====
CACHE_DRIVER=redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Queue (asynq / redis) =====
QUEUE_DRIVER=asynq
QUEUE_CONCURRENCY=10

# ===== Storage (local default, s3 optional) =====
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3 (also S3-compatible: MinIO, R2, Ceph — set endpoint + path_style)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=true

# ===== Mail (log default; smtp / ses optional) =====
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Go Project Starter
# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Amazon SES
SES_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=

# ===== SMS (log default; twilio optional) =====
SMS_DRIVER=log
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SID=

# ===== Auth =====
AUTH_JWT_SECRET=change-me-in-production
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
# require email verified before login (false = demo-friendly)
AUTH_REQUIRE_EMAIL_VERIFIED=false
# OTP / verification
OTP_LENGTH=6
OTP_TTL=15m
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m

# ===== RBAC =====
# TTL of the cached user roles/permissions; changes propagate within this window
RBAC_CACHE_TTL=5m
# Email of a user that gets the super_admin role on startup (must already exist)
RBAC_BOOTSTRAP_SUPER_ADMIN_EMAIL=

