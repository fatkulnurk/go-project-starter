# Copy this file to `.env` (same directory you run the binaries from) — every
# binary auto-loads it through config.Load(). Real environment variables always
# win over .env, so docker-compose and CI secrets keep precedence.

# ===== App =====
APP_ENV=development
APP_PORT=32100
# port of the public web binary (cmd/web), independent of the API
WEB_PORT=32101
APP_BASE_URL=http://localhost:32100
# brand name injected into rendered email/SMS templates
APP_NAME=Go Project Starter
# IANA timezone the whole app follows (DB sessions, clock, stored timestamps).
# Use a named zone (e.g. Asia/Jakarta) or UTC. MySQL named zones require the
# server timezone tables to be loaded (mysql_tzinfo_to_sql); UTC/offsets always work.
APP_TIMEZONE=UTC

# ===== Database (mysql default, postgres optional) =====
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=go_project_starter
# connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
# max time an idle connection is kept; 0 disables
DB_CONN_MAX_IDLE_TIME=5m
# one of: disable, require, verify-ca, verify-full (postgres) / true, skip-verify (mysql)
DB_SSL_MODE=disable

# For postgres use: DB_DRIVER=postgres, DB_PORT=5432

# ===== Cache (redis default; memory or db optional) =====
# CACHE_DRIVER=db reuses the DB_* connection above and stores entries in the
# cache table (Laravel-style key/value/expiration).
CACHE_DRIVER=redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# connection pool
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=1
# per-operation timeouts; 0 disables
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ===== Queue (asynq / redis default; db optional) =====
# QUEUE_DRIVER=db reuses the DB_* connection above and stores jobs in the
# queue_jobs table (Laravel-style). No Redis needed; jobs survive worker crashes.
QUEUE_DRIVER=asynq
QUEUE_CONCURRENCY=10
# Queue reuses REDIS_ADDR/REDIS_PASSWORD but lives in its own logical DB so it
# never collides with the cache keys (cache is REDIS_DB, queue is QUEUE_REDIS_DB).
QUEUE_REDIS_DB=1
QUEUE_REDIS_POOL_SIZE=10

# ===== Pub/Sub (memory default; redis / rabbitmq / kafka optional) =====
# memory: in-process bus only (single binary); redis: fire-and-forget broadcast;
# rabbitmq/kafka: durable broadcast (see internal/platform/pubsub/README.md).
# Ports below match docker compose (compose.yaml); the queue/scheduler use
# REDIS_ADDR for PUBSUB_DRIVER=redis.
PUBSUB_DRIVER=memory
# unique per subscriber instance; empty = random per process (broadcast). Set a
# shared value to make instances compete (RabbitMQ shares the queue, Kafka the group).
PUBSUB_INSTANCE_ID=
# RabbitMQ
PUBSUB_RABBITMQ_URL=amqp://guest:guest@localhost:32130
PUBSUB_RABBITMQ_EXCHANGE=pubsub
# durable subscriber queues survive broker restarts
PUBSUB_RABBITMQ_DURABLE=true
# Kafka (comma-separated brokers)
PUBSUB_KAFKA_BROKERS=localhost:32140
PUBSUB_KAFKA_CLIENT_ID=pubsub
PUBSUB_KAFKA_GROUP_PREFIX=pubsub

# ===== Storage (local default, s3 optional) =====
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3 (also S3-compatible: MinIO, R2, Ceph — set endpoint + path_style)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=true

# ===== Public assets =====
# directory served statically at /assets/* by the API and web servers
PUBLIC_DIR=./public
# absolute base URL of static assets (email/web). Empty = APP_BASE_URL,
# so you can point it at a CDN in production.
ASSETS_BASE_URL=

# ===== Mail (log default; smtp / ses optional) =====
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Go Project Starter
# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# pooled connections (default 5)
MAIL_SMTP_POOL_SIZE=5
# one of: none, tls (implicit TLS e.g. port 465), starttls (default)
MAIL_SMTP_SSL=starttls
# Amazon SES
SES_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=

# ===== SMS (log default; twilio optional) =====
SMS_DRIVER=log
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SID=

# ===== Auth =====
# at least 32 characters; the API refuses to start with a shorter value
AUTH_JWT_SECRET=change-me-in-production-go-project-starter
AUTH_JWT_ISSUER=go-project-starter
AUTH_JWT_AUDIENCE=go-project-starter-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
# require email verified before login (false = demo-friendly)
AUTH_REQUIRE_EMAIL_VERIFIED=false
# OTP / verification
OTP_LENGTH=6
OTP_TTL=15m
OTP_MAX_ATTEMPTS=5
# expiry of passwordless magic links
MAGIC_LINK_TTL=15m
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m
# shared cap for every unauthenticated endpoint (register, magic link,
# forgot/reset password, refresh) per client IP
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_PUBLIC_WINDOW=1m
# expands local phone numbers (leading 0) to E.164 on registration/login,
# e.g. 62 for Indonesia; empty keeps "+" numbers unchanged
AUTH_DEFAULT_COUNTRY_CODE=
# maximum concurrent sessions (refresh-token families) per user; oldest are
# revoked when the cap is exceeded
AUTH_MAX_SESSIONS=10

# ===== Media =====
# maximum accepted upload body in bytes (0 = unlimited)
MEDIA_MAX_UPLOAD_SIZE=10485760

# ===== HTTP hardening =====
# comma-separated CIDRs of reverse proxies that may set X-Forwarded-For
TRUSTED_PROXIES=
# comma-separated origins allowed to call the API from browsers (empty = same-origin only)
CORS_ALLOWED_ORIGINS=

# ===== RBAC =====
# TTL of the cached user roles/permissions; changes propagate within this window
RBAC_CACHE_TTL=5m
# Demo accounts and default roles/permissions are defined in the module seeder
# packages; run `go run ./cmd/seed` after `go run ./cmd/migrate up` to create
# them (see auth/seeder.DefaultUsers).

